{
  "project": {
    "name": "VvE Navigator",
    "country": "Nederland",
    "architecture": "Decision Intelligence Platform",
    "build": "3.1.0"
  },
  "modules": [
    "Decision Intelligence Platform", "Executive Cockpit", "Finance Engine", "Financial Cockpit", "Forecast & Predictive Engine", "Stress Test & Monte Carlo Engine", "Optimization Engine", "Strategy Optimizer", "Recommendation & Explainability Engine", "MJOP Engine", "Risk Engine", "Decision Engine", "Governance & ALV Engine", "Action & Execution Engine", "Audit & Control Engine", "Compliance & Quality Engine", "Integration & Release Engine", "Enterprise Core", "Release Manifest", "Observability & Health Engine", "Configuration & Policy Engine", "Portfolio Engine", "Dashboard Engine", "Report Engine", "DataHub", "Scenario Engine", "Power BI Export", "Excel Master Workbook"
  ],
  "defaults": {"inflation_rate": 0.04, "discount_rate": 0.03, "planning_horizon_years": 30, "currency": "EUR", "apartments": 34},
  "decision_intelligence": {"enabled": true, "version": "3.1.0", "inputs": ["forecast", "stress_test", "optimization", "strategy", "recommendation"], "statuses": ["BESLUITRIJP", "VOORBEREIDEN", "HERZIEN"], "readiness_score": true, "board_decision": true, "explainable": true},
  "executive_cockpit": {"enabled": true, "kpis": ["decision_readiness", "vni", "reserve", "deficit_probability", "best_strategy", "monthly_per_apartment", "health_score"], "top_actions": 3, "board_view": true},
  "risk": {"critical_threshold": 75, "high_threshold": 50, "normal_threshold": 25},
  "decision": {"enabled": true, "top_n": 5, "weights": {"risk": 0.5, "condition": 0.3, "liquidity": 0.2}, "priority_thresholds": {"now": 75, "high": 50, "plan": 25}},
  "governance": {"enabled": true, "default_owner": "Bestuur", "statuses": ["BESLUIT NODIG", "VOORBEREIDEN", "AGENDEREN", "VOLGEN"], "alv_proposals": true, "track_financial_impact": true},
  "execution": {"enabled": true, "statuses": ["OPEN", "LOPEND", "VERTRAAGD", "BLOKKADE", "GEREED", "GESTOPT"], "traffic_lights": ["GROEN", "GEEL", "ORANJE", "ROOD"], "track_budget": true, "track_progress": true, "track_deadlines": true},
  "audit": {"enabled": true, "require_actor": true, "require_reason": true, "timestamp_utc": true, "track": ["DECISION", "BUDGET_MUTATION", "EXECUTION", "CONFIG_CHANGE", "DATA_CHANGE"], "immutable_event_model": true},
  "compliance": {"enabled": true, "publication_gate": true, "block_on_missing_fields": true, "block_on_negative_reserve": true, "block_on_invalid_condition": true, "block_on_incomplete_decisions": true},
  "release": {"enabled": true, "pipeline": ["Dataset", "MJOP", "Finance", "Forecast", "Stress Test", "Optimization", "Strategy Optimization", "Recommendation & Explainability", "Decision Intelligence", "Executive Cockpit", "Risk", "Decision", "Governance", "Execution", "Audit", "Compliance", "Dashboard", "Reporting", "Export"], "require_quality_gate": true, "release_package": true, "manifest": true, "regression_fingerprint": true},
  "enterprise": {"enabled": true, "profile": "production", "version": "3.1.0", "ci": "GitHub Actions", "fail_safe_errors": true, "require_manifest": true, "observability": true, "policy_profiles": true, "portfolio": true, "predictive_forecast": true, "monte_carlo_stress": true, "optimization": true, "strategy_optimization": true, "explainable_recommendations": true, "decision_intelligence": true, "executive_cockpit": true},
  "health": {"enabled": true, "statuses": ["HEALTHY", "DEGRADED", "CRITICAL"], "checks": ["release", "manifest", "quality_gate"], "include_warnings": true, "health_score": true},
  "policy": {"enabled": true, "default_profile": "standard_vve", "directory": "config/policies", "configurable": ["inflation_rate", "discount_rate", "horizon_years", "reserve_floor", "risk_thresholds", "quality_gate", "publishability", "scenario_set"]},
  "portfolio": {"enabled": true, "metrics": ["vni", "reserve_fund", "risk_score", "mjop_pressure", "health_score", "investment_need"], "priority_count": 5, "compare_publishability": true},
  "forecast": {"enabled": true, "lookahead_years": 5, "levels": ["STABIEL", "AANDACHT", "WAARSCHUWING", "KRITIEK"], "signals": ["reserve_floor", "negative_reserve", "mjop_peak", "risk_score"], "early_warning": true},
  "stress_test": {"enabled": true, "method": "Monte Carlo", "default_simulations": 1000, "seeded_reproducibility": true, "uncertainties": ["inflation", "cost_overrun", "delay", "unexpected_costs"], "risk_levels": ["BEHEERSBAAR", "AANDACHT", "HOOG", "KRITIEK"], "outputs": ["deficit_probability", "p10", "p50", "p90", "yearly_deficit_probability"]},
  "optimization": {"enabled": true, "target_deficit_probability": 0.05, "optimize": ["annual_contribution", "reserve_buffer"], "objective": "minimum_total_financing_cost", "default_simulations": 500},
  "strategy_optimizer": {"enabled": true, "target_deficit_probability": 0.05, "optimize": ["scenario", "maintenance_timing", "annual_contribution", "reserve_buffer"], "scenario_set": ["Basis", "Duurzaam", "Versneld"], "timing_shift_years": [-1, 0, 1, 2], "objective": "lowest_robust_30_year_strategy", "include_sustainability_score": true},
  "recommendation": {"enabled": true, "audience": "Bestuur en ALV", "explain": ["why_this_strategy", "financial_effect", "risk_effect", "sustainability_effect", "rejected_alternatives"], "confidence_levels": ["HOOG", "MIDDEL", "LAAG"], "board_ready_text": true},
  "dashboard": {"name": "Bestuur Cockpit", "vni_weight_reserve": 0.35, "vni_weight_mjop": 0.25, "vni_weight_risk": 0.25, "vni_weight_condition": 0.15, "top_actions": 3},
  "reporting": {"board_report": true, "alv_report": true, "planning_horizon_years": 30, "top_decisions": 3},
  "export": {"schema_version": "1.0", "formats": ["JSON", "CSV", "Excel", "Power BI"], "flat_data_contract": true},
  "excel_master": {"enabled": true, "sheets": ["Executive Cockpit", "Dashboard", "Decision Intelligence", "Portfolio", "Forecast", "Stress Test", "Optimalisatie", "Strategie Optimalisatie", "Advies & Uitleg", "VvE", "Appartementen", "MJOP", "Finance", "Financial Cockpit", "Risico", "Besluiten", "ALV & Governance", "Acties & Uitvoering", "Audit & Control", "Compliance & Quality", "Release", "Health", "Beleid & Configuratie", "Instellingen", "Rapportage", "Scenario's", "Export"]},
  "scenarios": {"enabled": true, "default_set": "Basis-Duurzaam-Versneld"},
  "financial_cockpit": {"enabled": true, "reserve_interest": 0.01, "contribution_growth": 0.02, "operating_cost_growth": 0.02, "liquidity_alert_below_zero": true}
}
