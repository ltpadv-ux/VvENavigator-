{
  "project": {
    "name": "VvE Navigator",
    "country": "Nederland",
    "architecture": "Master Engine",
    "build": "1.5.0"
  },
  "modules": [
    "Finance Engine", "Financial Cockpit", "MJOP Engine", "Risk Engine", "Decision Engine", "Governance & ALV Engine", "Dashboard Engine",
    "Report Engine", "DataHub", "Scenario Engine", "Power BI Export", "Excel Master Workbook"
  ],
  "defaults": {
    "inflation_rate": 0.04,
    "discount_rate": 0.03,
    "planning_horizon_years": 30,
    "currency": "EUR",
    "apartments": 34
  },
  "risk": {"critical_threshold": 75, "high_threshold": 50, "normal_threshold": 25},
  "decision": {
    "enabled": true,
    "top_n": 5,
    "weights": {"risk": 0.5, "condition": 0.3, "liquidity": 0.2},
    "priority_thresholds": {"now": 75, "high": 50, "plan": 25}
  },
  "governance": {
    "enabled": true,
    "default_owner": "Bestuur",
    "statuses": ["BESLUIT NODIG", "VOORBEREIDEN", "AGENDEREN", "VOLGEN"],
    "alv_proposals": true,
    "track_financial_impact": true
  },
  "dashboard": {
    "name": "Bestuur Cockpit",
    "vni_weight_reserve": 0.35,
    "vni_weight_mjop": 0.25,
    "vni_weight_risk": 0.25,
    "vni_weight_condition": 0.15,
    "top_actions": 3
  },
  "reporting": {"board_report": true, "alv_report": true, "planning_horizon_years": 30, "top_decisions": 3},
  "export": {"schema_version": "1.0", "formats": ["JSON", "CSV", "Excel", "Power BI"], "flat_data_contract": true},
  "excel_master": {
    "enabled": true,
    "sheets": ["Dashboard", "VvE", "Appartementen", "MJOP", "Finance", "Financial Cockpit", "Risico", "Besluiten", "ALV & Governance", "Instellingen", "Rapportage", "Scenario's", "Export"]
  },
  "scenarios": {"enabled": true, "default_set": "Basis-Duurzaam-Versneld"},
  "financial_cockpit": {
    "enabled": true,
    "reserve_interest": 0.01,
    "contribution_growth": 0.02,
    "operating_cost_growth": 0.02,
    "liquidity_alert_below_zero": true
  }
}